# Variáveis lidas pelo docker-compose.yml (não pelo Laravel — isso é backend/.env.example).
# Copie para .env na raiz só se precisar mudar os padrões abaixo.

DB_DATABASE=lar_analia_franco
DB_USERNAME=lar
DB_PASSWORD=lar

# Portas expostas no host. Mude se já houver outro serviço local usando a porta padrão
# (ex.: um Postgres nativo já rodando em 5432).
APP_FORWARD_PORT=8000
DB_FORWARD_PORT=5432
REDIS_FORWARD_PORT=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
