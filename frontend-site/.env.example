# URL base da API pública (Laravel), sem barra final.
NUXT_PUBLIC_API_URL=http://localhost:8000

# URL do site público, usada para gerar sitemap.xml, canonical e Open Graph absolutos.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Umami (analytics cookieless). Deixar em branco em dev — o plugin não injeta o script sem
# essas duas variáveis. Sem GA4, sem banner de cookies (ver docs/arquitetura.md).
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_PUBLIC_UMAMI_URL=

# Ambiente em que este site está servindo. Só `staging` tem efeito: liga o
# `X-Robots-Tag: noindex, nofollow` em todas as respostas e faz o robots.txt bloquear o site
# inteiro (ver server/middleware/staging-noindex.ts). Deixar vazio em desenvolvimento e em
# produção — em produção, preencher isto por engano tira o site da busca.
NUXT_PUBLIC_ENVIRONMENT=
