# URL base da API (Laravel), sem barra final.
VITE_API_URL=http://localhost:8000

# Minutos de inatividade antes do logout automático no painel.
VITE_SESSION_IDLE_TIMEOUT_MINUTES=15

# URL base do site público, sem barra final — usada só para o botão "Abrir no site" na tela
# de edição de página. Sem isso o botão apontaria para o próprio painel.
VITE_SITE_URL=http://localhost:3000
