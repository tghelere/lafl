# Carregado automaticamente quando APP_ENV=e2e (ver
# Illuminate\Foundation\Bootstrap\LoadEnvironmentVariables::checkForSpecificEnvironmentFile) —
# em vez de backend/.env. Só valores fictícios: chaves aqui nunca protegem dado real (ver
# docs/protecao-de-dados.md), commitado de propósito, mesma exceção de .gitignore que
# backend/.env.testing já tinha.
#
# TERCEIRO banco, separado do de desenvolvimento (lar_analia_franco) e do da suíte Pest
# (lar_analia_franco_test), no mesmo Postgres do docker-compose. A bateria de ponta a ponta
# roda `migrate:fresh` a cada execução: apontar isto para qualquer outro banco apaga o
# trabalho de alguém. `php artisan e2e:prepare` recusa rodar se o banco resolvido não for o
# de e2e — ver App\Console\Commands\PrepareE2eDatabase.
#
# Nunca SQLite, aqui como em qualquer outro lugar (ver CLAUDE.md, "Armadilhas conhecidas").
APP_ENV=e2e
APP_NAME="Lar Anália Franco"
APP_KEY=base64:Mdke6zWOWR+Fv+adG7ZfeS7P28cr0b3qMCmyBinMjao=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8100
APP_MAINTENANCE_DRIVER=file

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Hash barato de propósito: a bateria faz dezenas de logins reais, e o custo do bcrypt padrão
# dominaria o tempo total sem testar nada a mais. Mesmo valor de backend/.env.testing.
BCRYPT_ROUNDS=4
BROADCAST_CONNECTION=null

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lar_analia_franco_e2e
DB_USERNAME=lar
DB_PASSWORD=lar

# --- Autenticação: Sanctum em SPA mode ---
# Portas próprias da bateria (5175 painel, 3100 site), para não colidir com o `npm run dev`
# de desenvolvimento (5173 e 3000) rodando na mesma máquina. O cookie de sessão não distingue
# porta — só domínio —, mas cada contexto de navegador do Playwright tem o próprio jar, então
# uma sessão de teste nunca encosta na sessão aberta no navegador de verdade.
SANCTUM_STATEFUL_DOMAINS=localhost:5175,localhost:3100,127.0.0.1:5175,127.0.0.1:3100
SESSION_DOMAIN=localhost

CORS_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:3100

TRUSTED_PROXIES=127.0.0.1,::1

# --- Cache, sessão e filas (Redis) ---
# Índices de banco do Redis próprios (3 e 4), distintos dos de desenvolvimento (0 e 1): a
# bateria roda `cache:clear` no começo, e sem índice próprio isso derrubaria a sessão aberta
# no navegador de desenvolvimento e o cache de página pública dele.
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=3
REDIS_CACHE_DB=4

# Nenhum e-mail sai daqui: a bateria não depende de Mailpit, e no CI ele não existe.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Chaves só para a bateria de ponta a ponta — nunca usar em ambiente real (ver
# docs/protecao-de-dados.md).
FIELD_ENCRYPTION_KEY=base64:ItCy2nUZ9KG5VGNdNT9HMO1QZ+maXgvYGfZc2LlJwG8=
BLIND_INDEX_KEY=base64:a2NgBC9RnrTFJEeS9+LfGyGyZW1KqceMMyjaF0UdvY8=

# URL base do painel — é com ela que App\Actions\Users\GeneratePasswordLink monta o link de
# /definir-senha que o teste de criação de usuário abre no segundo contexto de navegador.
ADMIN_BASE_URL=http://localhost:5175
# URL base do site — monta a URL absoluta da logo no cabeçalho do e-mail de notificação.
SITE_BASE_URL=http://localhost:3100
FORM_CONSENT_TERMS_VERSION=2026-09-18
