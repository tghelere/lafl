includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes

    level: 8

    # Modelos deste projeto usam o método casts() (Laravel 11+), não a propriedade $casts —
    # sem esta flag o Larastan infere o tipo bruto da coluna (ex.: string) em vez do tipo
    # após o cast (ex.: App\Enums\PageStatus), e gera falso positivo em toda comparação ou
    # chamada de método sobre um atributo castado.
    parseModelCastsMethod: true

    excludePaths:
        - app/Providers/*ServiceProvider.php

    checkOctaneCompatibility: true

    ignoreErrors:
        -
            # HasBlindIndex é infraestrutura sem consumidor de domínio ainda por decisão
            # explícita desta fatia (ver docs/protecao-de-dados.md e o model de exemplo em
            # tests/Feature/DataProtection) — não é código morto a remover.
            identifier: trait.unused
            path: app/Models/Concerns/HasBlindIndex.php
