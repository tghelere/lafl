APP_NAME="Lar Anália Franco"
APP_ENV=local
# Gerar com: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

# Locale de conteúdo voltado ao usuário (mensagens, labels) é sempre pt_BR — ver CLAUDE.md
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Banco de dados (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lar_analia_franco
DB_USERNAME=lar
DB_PASSWORD=lar

# --- Cache, sessão e filas (Redis) ---
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail (Mailpit em dev) ---
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="nao-responda@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- Autenticação: Sanctum em SPA mode ---
# Domínios (sem protocolo, com porta se aplicável) autorizados a autenticar via cookie.
# Em produção: os domínios reais do frontend-site e do frontend-admin, sob o mesmo domínio raiz.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000
# Domínio raiz do cookie de sessão. Em produção precisa ser o domínio raiz compartilhado
# entre API e frontends (ex.: .dominio.org.br) — ver docs/arquitetura.md, seção Autenticação.
SESSION_DOMAIN=localhost

# --- CORS ---
# Origens completas (com protocolo e porta) autorizadas a fazer requisições com credenciais.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Proteção de dados: chaves de criptografia dedicadas ---
# NUNCA usar o mesmo valor do APP_KEY. Gerar com: php artisan key:generate --show
# Usada pelo cast App\Casts\FieldEncrypted para campos pessoais de assistido/responsável.
# Perder esta chave é perder os dados cifrados — guardar backup em local distinto do backup
# do banco (ver docs/protecao-de-dados.md).
FIELD_ENCRYPTION_KEY=
# Chaves antigas, separadas por vírgula, usadas durante rotação de FIELD_ENCRYPTION_KEY.
FIELD_ENCRYPTION_PREVIOUS_KEYS=

# Chave HMAC-SHA256 dedicada para os blind indexes (busca/checagem de duplicidade sem
# descriptografar). Precisa ser diferente de APP_KEY e de FIELD_ENCRYPTION_KEY.
BLIND_INDEX_KEY=
BLIND_INDEX_PREVIOUS_KEYS=

# --- Analytics / integrações externas (site público) ---
# Sem valor aqui ainda — ver frontend-site/.env.example. Backend não fala com Umami.

# --- Formulários públicos (ver docs/dominio.md, "Formulários recebidos") ---
# Destinatário de notificação por tipo de formulário. Endereços reais são [LACUNA] (ver
# docs/contexto.md) — os padrões em config/forms.php já são placeholders óbvios em domínio
# reservado (.invalid, RFC 2606). Deixe comentado até haver endereço real: env() só cai no
# default de config/forms.php quando a chave não existe no .env — definida aqui, mesmo em
# branco, o Laravel usaria uma string vazia como destinatário do e-mail (bug real encontrado
# nesta sessão, ver docs/roadmap.md). Descomente e preencha linha a linha quando confirmado.
# FORM_RECIPIENT_ENROLLMENT_INTEREST=
# FORM_RECIPIENT_PROGRAM_APPLICATION=
# FORM_RECIPIENT_PICKUP_REQUEST=
# FORM_RECIPIENT_VOLUNTEER_APPLICATION=
# FORM_RECIPIENT_PARTNERSHIP_INQUIRY=
# FORM_RECIPIENT_CONTACT_MESSAGE=
# URL base do painel administrativo, usada só para montar o link nos e-mails de notificação —
# a tela em si ainda não existe (ver docs/roadmap.md).
ADMIN_BASE_URL=http://localhost:5173
# Versão do termo de consentimento gravada a cada envio. Mudar sempre que o texto de
# /politica-de-privacidade (ainda não publicada) mudar de forma relevante.
FORM_CONSENT_TERMS_VERSION=2026-08-25

TELESCOPE_ENABLED=true
