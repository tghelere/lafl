APP_NAME="Lar Anália Franco"
APP_ENV=local
# Gerar com: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

# Locale de conteúdo voltado ao usuário (mensagens, labels) é sempre pt_BR — ver CLAUDE.md
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Banco de dados (PostgreSQL) ---
# PostgreSQL é o único banco suportado — desenvolvimento, teste e produção (ver CLAUDE.md,
# "Armadilhas conhecidas"). São TRÊS bancos, no mesmo Postgres do docker-compose, cada um com
# seu arquivo de ambiente — nenhum deles compartilha dado com outro:
#
#   | banco                   | arquivo             | quem usa                                |
#   |-------------------------|---------------------|-----------------------------------------|
#   | lar_analia_franco       | backend/.env        | desenvolvimento (este arquivo)          |
#   | lar_analia_franco_test  | backend/.env.testing| Pest e os scripts de concorrência       |
#   | lar_analia_franco_e2e   | backend/.env.e2e    | bateria Playwright (`npm run test:e2e`) |
#
# Os dois últimos são commitados (só valores fictícios) para rodarem igual em qualquer máquina
# e no CI. Tanto a suíte quanto a bateria de ponta a ponta rodam `migrate:fresh`: apontar o
# arquivo errado para este banco aqui apaga o trabalho de desenvolvimento. Ver README, seção
# "Testes e qualidade", e e2e/README.md.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lar_analia_franco
DB_USERNAME=lar
DB_PASSWORD=lar

# --- Cache, sessão e filas (Redis) ---
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail (Mailpit em dev) ---
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="nao-responda@example.org"
MAIL_FROM_NAME="${APP_NAME}"
# Destinatário único (só homologação). Definido, TODO e-mail da aplicação é reendereçado para
# este endereço e cc/bcc são descartados — é o que permite a instituição testar os formulários
# em staging sem que nada chegue aos endereços reais do FORM_RECIPIENT_*. Vazio em
# desenvolvimento (o Mailpit já retém tudo) e em produção.
# MAIL_ALWAYS_TO=

# --- Autenticação: Sanctum em SPA mode ---
# Domínios (sem protocolo, com porta se aplicável) autorizados a autenticar via cookie.
# Em produção: os domínios reais do frontend-site e do frontend-admin, sob o mesmo domínio raiz.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000
# Domínio raiz do cookie de sessão. Em produção precisa ser o domínio raiz compartilhado
# entre API e frontends (ex.: .dominio.org.br) — ver docs/arquitetura.md, seção Autenticação.
SESSION_DOMAIN=localhost

# --- CORS ---
# Origens completas (com protocolo e porta) autorizadas a fazer requisições com credenciais.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Proxy confiável (ver bootstrap/app.php) ---
# IPs autorizados a informar o IP real do visitante via X-Forwarded-For — só o servidor do
# site público (Nuxt), que faz proxy servidor-a-servidor dos seis formulários para o redirect
# de sucesso funcionar sem JavaScript (ver frontend-site/server/api/forms/[tipo].post.ts).
# Em produção, o IP/CIDR real do serviço Nuxt; em dev, loopback já cobre (mesmo host).
TRUSTED_PROXIES=127.0.0.1,::1

# --- Proteção de dados: chaves de criptografia dedicadas ---
# NUNCA usar o mesmo valor do APP_KEY. Gerar com: php artisan key:generate --show
# Usada pelo cast App\Casts\FieldEncrypted para campos pessoais de assistido/responsável.
# Perder esta chave é perder os dados cifrados — guardar backup em local distinto do backup
# do banco (ver docs/protecao-de-dados.md).
FIELD_ENCRYPTION_KEY=
# Chaves antigas, separadas por vírgula, usadas durante rotação de FIELD_ENCRYPTION_KEY.
FIELD_ENCRYPTION_PREVIOUS_KEYS=

# Chave HMAC-SHA256 dedicada para os blind indexes (busca/checagem de duplicidade sem
# descriptografar). Precisa ser diferente de APP_KEY e de FIELD_ENCRYPTION_KEY.
BLIND_INDEX_KEY=
BLIND_INDEX_PREVIOUS_KEYS=

# --- Analytics / integrações externas (site público) ---
# Sem valor aqui ainda — ver frontend-site/.env.example. Backend não fala com Umami.

# --- Formulários públicos (ver docs/dominio.md, "Formulários recebidos") ---
# Destinatário de notificação por tipo de formulário. Endereços reais são [LACUNA] (ver
# docs/contexto.md) — os padrões em config/forms.php já são placeholders óbvios em domínio
# reservado (.invalid, RFC 2606). Deixe comentado até haver endereço real: env() só cai no
# default de config/forms.php quando a chave não existe no .env — definida aqui, mesmo em
# branco, o Laravel usaria uma string vazia como destinatário do e-mail (bug real encontrado
# nesta sessão, ver docs/roadmap.md). Descomente e preencha linha a linha quando confirmado.
# FORM_RECIPIENT_PROGRAM_APPLICATION=
# FORM_RECIPIENT_PICKUP_REQUEST=
# FORM_RECIPIENT_VOLUNTEER_APPLICATION=
# FORM_RECIPIENT_PARTNERSHIP_INQUIRY=
# FORM_RECIPIENT_CONTACT_MESSAGE=
# URL base do painel administrativo (frontend-admin). Duas finalidades: montar o link nos
# e-mails de notificação de formulário (tela ainda não existe, ver docs/roadmap.md) e montar
# a URL de /definir-senha que o super_admin copia e envia por fora ao criar um usuário — só o
# token vai na URL, nenhum dado pessoal (ver App\Actions\Users\GeneratePasswordLink).
ADMIN_BASE_URL=http://localhost:5173
# URL base do site público (frontend-site) — monta a URL absoluta da logo no cabeçalho do
# e-mail de notificação (ver resources/views/vendor/mail/html/message.blade.php). Cliente de
# e-mail não carrega caminho relativo, só HTTP(S) completo.
SITE_BASE_URL=http://localhost:3000
# Versão do termo de consentimento gravada a cada envio. Mudar sempre que o texto de
# /politica-de-privacidade (ainda não publicada) mudar de forma relevante.
FORM_CONSENT_TERMS_VERSION=2026-09-18

TELESCOPE_ENABLED=true

# =============================================================================
# staging e production — o que muda
# =============================================================================
# Este arquivo é o `.env` de DESENVOLVIMENTO. O `.env` de cada ambiente do servidor é criado
# lá, à mão, e nunca sai de lá (nem no repositório, nem no GitHub) — ver docs/deploy.md, que
# tem a checklist completa. As linhas abaixo existem para que a lista do que muda esteja junto
# das variáveis, sem nenhum valor real.
#
# APP_ENV=staging            (ou production)
# APP_DEBUG=false            SEMPRE — em nenhum dos dois o traceback vai para a resposta
# APP_URL=https://api.homologacao.SEUDOMINIO      (ou https://api.SEUDOMINIO)
# LOG_LEVEL=info             debug em servidor enche disco e registra demais
#
# As TRÊS chaves são geradas no servidor, uma por ambiente, e NUNCA reaproveitadas entre
# staging e production nem copiadas de desenvolvimento:
# APP_KEY=                   php artisan key:generate
# FIELD_ENCRYPTION_KEY=      php artisan key:generate --show
# BLIND_INDEX_KEY=           php artisan key:generate --show
# Perder FIELD_ENCRYPTION_KEY ou BLIND_INDEX_KEY é irreversível: os dados cifrados viram
# lixo e nenhum backup do banco os traz de volta. Backup das chaves em cofre de senhas,
# separado do backup do banco (ver docs/protecao-de-dados.md).
#
# Banco e Redis do servidor, escutando só em localhost, com usuário e base por ambiente:
# DB_HOST=127.0.0.1
# DB_DATABASE=lar_analia_franco_staging       (ou lar_analia_franco)
# DB_USERNAME= / DB_PASSWORD=                 usuário próprio de cada ambiente
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# Índices E prefixo próprios de cada ambiente. O prefixo padrão é derivado de APP_NAME e
# seria idêntico nos dois; com um Redis só na máquina, staging e production disputariam as
# mesmas chaves de sessão e de cache — e o efeito é gente deslogando sozinha em produção
# quando alguém abre homologação. infra/criar-ambiente.sh já escreve os três.
# REDIS_DB=1 / REDIS_CACHE_DB=2 / REDIS_PREFIX=laf-staging-     (3 / 4 / laf-production-)
# QUEUE_CONNECTION=redis     exige o worker no ar (ver docs/deploy.md, "Processos")
#
# Cookie do Sanctum: front e API precisam do mesmo domínio raiz (ver docs/arquitetura.md).
# SESSION_DOMAIN=.homologacao.SEUDOMINIO      (ou .SEUDOMINIO)
# SANCTUM_STATEFUL_DOMAINS=homologacao.SEUDOMINIO,painel.homologacao.SEUDOMINIO
# CORS_ALLOWED_ORIGINS=https://homologacao.SEUDOMINIO,https://painel.homologacao.SEUDOMINIO
# TRUSTED_PROXIES=127.0.0.1,::1               IP do Nginx/Nitro que faz o proxy dos formulários
#
# URLs absolutas usadas em e-mail e no link de definição de senha:
# ADMIN_BASE_URL=https://painel.homologacao.SEUDOMINIO
# SITE_BASE_URL=https://homologacao.SEUDOMINIO
#
# E-mail: Resend nos dois, via API HTTP (transporte nativo do Laravel, resend/resend-php —
# não é SMTP). Em staging, MAIL_ALWAYS_TO aponta para o endereço de teste e nenhum
# destinatário real recebe nada (ver acima). Ver docs/deploy.md, "E-mail (Resend)", para o
# passo a passo de DNS (SPF, DKIM, DMARC) e verificação do domínio de envio.
# MAIL_MAILER=resend
# RESEND_API_KEY=                             chave de API do Resend, uma por ambiente
# MAIL_FROM_ADDRESS=nao-responda@SUBDOMINIO-DE-ENVIO.SEUDOMINIO
#
# FORM_RECIPIENT_*: endereços reais da instituição nos dois ambientes — em staging eles nunca
# recebem nada, por causa do MAIL_ALWAYS_TO, e é de propósito que estejam ali: é assim que a
# homologação testa a configuração que vai para produção.
#
# TELESCOPE_ENABLED=false    nos dois
#
# Fora do backend, e nenhum dos dois entra no build: o site lê as NUXT_PUBLIC_* do ambiente
# do processo Nitro (shared/site.env no servidor) — inclusive NUXT_PUBLIC_ENVIRONMENT=staging,
# que é quem liga o noindex do site de homologação — e o painel lê /config.js em tempo de
# execução (shared/painel-config.js no servidor, ver
# docs/decisoes/0015-painel-configurado-em-tempo-de-execucao.md). As VITE_* de
# frontend-admin/.env.example só valem em desenvolvimento e na bateria de ponta a ponta.
