# Carregado automaticamente quando APP_ENV=testing (ver phpunit.xml e
# Illuminate\Foundation\Bootstrap\LoadEnvironmentVariables::checkForSpecificEnvironmentFile) —
# em vez de backend/.env. Só valores fictícios: chaves aqui nunca protegem dado real (ver
# docs/protecao-de-dados.md), commitado de propósito.
#
# Banco de teste dedicado (lar_analia_franco_test), separado do banco de desenvolvimento
# (lar_analia_franco) — ambos no mesmo Postgres do docker-compose, portas iguais. Nunca
# SQLite: um bug de LIKE sensível a maiúsculas passou pela suíte inteira sem ser notado
# enquanto ela rodava em SQLite (que ignora caixa por padrão, diferente do Postgres de
# desenvolvimento/produção) — ver CLAUDE.md, "Armadilhas conhecidas".
APP_ENV=testing
APP_KEY=base64:kAEeKB263szgBKpeWOIOYexBOJ97K+x3dIiPsxzOlnI=
APP_MAINTENANCE_DRIVER=file
APP_DEBUG=true

BCRYPT_ROUNDS=4
BROADCAST_CONNECTION=null

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lar_analia_franco_test
DB_USERNAME=lar
DB_PASSWORD=lar

# Mesmo valor do backend/.env de desenvolvimento — sem isto, o Origin
# "http://localhost:5173" que tests/Feature/Auth/ChangePasswordTest.php usa para simular o
# painel não bate contra domínio nenhum em EnsureFrontendRequestsAreStateful::fromFrontend(),
# a sessão nunca vira stateful e o cookie some da resposta (config/sanctum.php cai no padrão,
# que não inclui a porta 5173).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000
SESSION_DOMAIN=localhost

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Chaves só para teste — nunca usar em ambiente real (ver docs/protecao-de-dados.md).
FIELD_ENCRYPTION_KEY=base64:2CXDHL3fMP8mbXCe5JRiUEImexTHkhQ3hzgPvQif5V0=
BLIND_INDEX_KEY=base64:98GJMoj/GdVN6Z9BlvM7Xyjz5RyAQlZhTDIxMtLSVg8=

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
